tic/immutable/chunks/2xvxe7y777-2a.js\",\"/_next/static/immutable/chunks/3a6wg5gsg93t9.js\",\"/_next/static/immutable/chunks/18lu937a-y-yg.js\",\"/_next/static/immutable/chunks/202hycpof6zte.js\",\"/_next/static/immutable/chunks/13eq446wcd4m0.js\",\"/_next/static/immutable/chunks/0rpn4398pl93z.js\",\"/_next/static/immutable/chunks/1n5uny1s-e3zh.js\",\"/_next/static/immutable/chunks/0od4c2ah08wff.js\"],\"Ad\"]\n11f:[[[\"$\",\"$1\",\"section-0\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"article-content-wrapper\",\"style\":{\"gridRowStart\":4},\"data-article-body-start\":\"\",\"children\":[[\"$\",\"$L118\",null,{\"children\":[\"$\",\"$L12f\",null,{\"summary\":[{\"_key\":\"1cc02a97a4e7\",\"_type\":\"block\",\"children\":[{\"_key\":\"88a627670ae5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Parataxis has confirmed a merger with SilverBox Corp IV, which will take the firm public at a $400 million equity valuation, with potential to double the valuation.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f9ea0a75c120\",\"_type\":\"block\",\"children\":[{\"_key\":\"453bf0cc34cb\",\"_type\":\"span\",\"marks\":[],\"text\":\"The company has already raised $31 million in capital, which will be used to purchase bitcoin ahead of its public listing.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"283cfc363039\",\"_type\":\"block\",\"children\":[{\"_key\":\"baa3dbc80726\",\"_type\":\"span\",\"marks\":[],\"text\":\"Parataxis is expanding into South Korea through a rebrand of Bridge Biotherapeutics, which the company acquired in June.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"}]}]}],[\"$\",\"$L118\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"document-body font-body-lg  \\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t[\u0026_.premium-component]:!hidden\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t[\u0026_h1]:clear-both [\u0026_h1]:mt-4 [\u0026_h2]:clear-both [\u0026_h2]:mt-4 [\u0026_h3]:clear-both [\u0026_h3]:mt-4 [\u0026_.ad-container]:clear-both \",\"children\":[[\"$\",\"p\",\"00e5479fa745\",{\"children\":[\"Digital asset manager Parataxis Holdings is officially going public through a SPAC deal with SilverBox Corp IV, confirming earlier plans to list, it announced in a \",[\"$\",\"a\",\"4d5d72de8b2d\",{\"href\":\"https://www.businesswire.com/news/home/20250806695621/en/Bitcoin-Native-Institutional-Digital-Asset-Management-Platform-Parataxis-Holdings-to-Go-Public-via-Combination-with-SilverBox-Corp-IV\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"press release\"]}],\" on Wednesday.\"]}],[\"$\",\"p\",\"9ce11d73a21a\",{\"children\":[\"\"]}],[\"$\",\"p\",\"522fb7509c39\",{\"children\":[\"The new entity will be called Parataxis Holdings Inc. and aims to trade under the ticker “PRTX” on the New York Stock Exchange (NYSE).\"]}],[\"$\",\"p\",\"44b6fa0e918b\",{\"children\":[\"\"]}],[\"$\",\"p\",\"2cae9e58b14b\",{\"children\":[\"At a $10 share price, the deal values the combined company at $400 million, with the potential to double that figure if Parataxis exercises the right to raise an additional $400 million through a share purchase agreement. About $31 million has already been raised and earmarked for purchasing bitcoin \",[\"$\",\"$L130\",\"sz4f3osi5\",{\"value\":{\"_type\":\"asset\",\"href\":\"/price/bitcoin\",\"iso\":\"BTC\",\"title\":\"Bitcoin\",\"slug\":\"bitcoin\",\"price\":82486.388711308,\"fiat\":{\"id\":5,\"symbol\":\"USD\",\"type\":\"FIAT\"},\"change\":-509.2015546993,\"_key\":\"tazg08cbf\"}}],\", giving future shareholders immediate exposure to the asset.\"]}],[\"$\",\"p\",\"4a56218c5955\",{\"children\":[\"\"]}],[\"$\",\"p\",\"1722146ec1df\",{\"children\":[\"Parataxis manages bitcoin in an active strategy that blends market exposure with yield-generating techniques. Unlike firms that simply hold BTC, Parataxis seeks to generate income through low-volatility trading and treasury-style operations. The platform is run by veterans from Parataxis Capital Management and serves institutional client, including pension firms and family offices.\"]}],[\"$\",\"p\",\"0c0e88744e7f\",{\"children\":[\"\"]}]]}]}],false]}],[\"$\",\"div\",null,{\"className\":\"col-span-4 px-6 hidden lg:flex lg:col-start-9 xl:col-start-13 flex-col gap-4 justify-start\",\"style\":{\"gridRowStart\":3,\"gridRowEnd\":5},\"children\":[[\"$\",\"$L118\",null,{\"children\":[\"$\",\"$L131\",null,{\"sticky\":true,\"adId\":\"right_rail_tall\",\"refId\":\"article_rec_tall\",\"targeting\":{\"pos\":\"rec\",\"adIndex\":\"0\"}}]}],[\"$\",\"div\",null,{\"id\":\"cd-survey-slot\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 xl:hidden\",\"children\":[\"$\",\"$L118\",null,{\"children\":\"$L132\"}]}],null,null]}],[\"$\",\"div\",null,{\"className\":\"col-span-4 px-6 hidden xl:flex flex-col xl:col-start-1\",\"style\":{\"gridRowStart\":3,\"gridRowEnd\":5},\"children\":[\"$\",\"$L118\",null,{\"children\":\"$L133\"}]}],\"$L134\"]}],\"$L135\"],\"$L136\",null,\"$L137\"]\n138:I[601033,[\"/_next/static/immutable/chunks/0cktewol8v0ao.js\",\"/_next/static/immutable/chunks/1zbq-1mvpxezr.js\",\"/_next/static/immutable/chunks/0nejbw_-3_cx0.js\",\"/_next/static/immutable/chunks/3b0kgmptg_hhl.js\",\"/_next/static/immutable/chunks/2xq0jp4k7f903.js\",\"/_next/static/immutable/chunks/3p5txnl3j9jf0.js\",\"/_next/static/immutable/chunks/1-cm338wwxlu6.js\",\"/_next/static/immutable/chunks/3ash71gelm8ek.js\",\"/_next/static/immutable/chunks/0g-ua5ih80_9g.js\",\"/_next/static/immutable/chunks/1cj16byowopo9.js\",\"/_next/static/immutable/chunks/436m88htvh5fe.js\",\"/_next/static/immutable/chunks/0ooc2zwkfm77o.js\",\"/_next/static/immutable/chunks/2kqk82oquep7h.js\",\"/_next/static/immutable/chunks/34wh_xgflj91p.js\",\"/_next/static/immutable/chunks/1bq_jtp2kxewc.js\",\"/_next/static/immutable/chunks/2jdri5f-acn8h.js\",\"/_next/static/immutable/chunks/3dzgg3lj9_ys6.js\",\"/_next/static/immutable/chunks/43u0a