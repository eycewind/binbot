nks/0ooc2zwkfm77o.js\",\"/_next/static/immutable/chunks/2kqk82oquep7h.js\",\"/_next/static/immutable/chunks/34wh_xgflj91p.js\",\"/_next/static/immutable/chunks/1bq_jtp2kxewc.js\",\"/_next/static/immutable/chunks/2jdri5f-acn8h.js\",\"/_next/static/immutable/chunks/3dzgg3lj9_ys6.js\",\"/_next/static/immutable/chunks/43u0aun0hvoje.js\",\"/_next/static/immutable/chunks/3vm_629gf3pll.js\",\"/_next/static/immutable/chunks/2xvxe7y777-2a.js\",\"/_next/static/immutable/chunks/3a6wg5gsg93t9.js\",\"/_next/static/immutable/chunks/18lu937a-y-yg.js\",\"/_next/static/immutable/chunks/202hycpof6zte.js\",\"/_next/static/immutable/chunks/13eq446wcd4m0.js\",\"/_next/static/immutable/chunks/0rpn4398pl93z.js\",\"/_next/static/immutable/chunks/1n5uny1s-e3zh.js\",\"/_next/static/immutable/chunks/0od4c2ah08wff.js\"],\"LazyVideoPlayerAnalytics\"]\n134:[\"$\",\"div\",null,{\"className\":\"col-span-full\",\"style\":{\"gridRowStart\":5},\"children\":[\"$\",\"$L138\",null,{\"media\":\"desktop\",\"index\":0,\"isPremium\":false}]}]\n135:[\"$\",\"$1\",\"section-1\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"article-content-wrapper\",\"style\":{\"gridRowStart\":6},\"children\":[false,[\"$\",\"$L118\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"document-body font-body-lg  \\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t[\u0026_.premium-component]:!hidden\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t[\u0026_h1]:clear-both [\u0026_h1]:mt-4 [\u0026_h2]:clear-both [\u0026_h2]:mt-4 [\u0026_h3]:clear-both [\u0026_h3]:mt-4 [\u0026_.ad-container]:clear-both \",\"children\":[[\"$\",\"p\",\"9e4cca50f0ec\",{\"children\":[\"In June, Parataxis made its first international move by \",[\"$\",\"a\",\"86b1af8e31d7\",{\"href\":\"/business/2025/06/20/a-south-korean-biotech-firms-gets-1833m-funding-to-build-bitcoin-treasury\",\"children\":[\"acquiring a controlling stake in Bridge Biotherapeutics\"]}],\", a healthcare firm listed on South Korea’s KOSDAQ. That firm will be renamed Parataxis Korea and serve as a regional base for its bitcoin treasury strategy. Since the announcement, Bridge shares have jumped 350%, showing strong investor demand for the bitcoin-proxy play.\"]}],[\"$\",\"p\",\"91bdad3ae07c\",{\"children\":[\"\"]}],[\"$\",\"p\",\"5b32fdd84d5d\",{\"children\":[\"South Korea offers a large user base, political support for digital assets, and notably, no spot Bitcoin ETF — making the market fertile ground for BTC-focused public firms, the company said. Similar strategies have gained traction in Japan, where companies like Metaplanet have seen share prices surge after pivoting to bitcoin.\"]}],[\"$\",\"p\",\"ab3a8131caf5\",{\"children\":[\"\"]}],[\"$\",\"p\",\"01c4eeb1e60c\",{\"children\":[\"The Parataxis-SPAC deal will also allow the firm to expand its U.S. treasury operations and explore other “special situations” investments. If successful, Parataxis could become one of the few publicly listed companies offering direct and active exposure to bitcoin outside of an ETF structure.\"]}],[\"$\",\"p\",\"ee2dcba65a9b\",{\"children\":[\"\"]}],[\"$\",\"p\",\"06720ee352c4\",{\"children\":[\"The transaction is expected to close pending shareholder approval and a review from the Securities and Exchange Commission.\"]}]]}]}],null]}],[\"$\",\"div\",null,{\"className\":\"col-span-4 px-6 hidden lg:flex lg:col-start-9 xl:col-start-13 flex-col gap-4 justify-center\",\"style\":{\"gridRowStart\":6},\"children\":[null,null,null,[[\"$\",\"$L118\",null,{\"children\":[\"$\",\"$L139\",null,{\"newsletter\":{\"title\":\"Crypto Daybook Americas - The latest moves in crypto markets, in context\",\"slug\":\"daybook-us\",\"frequency\":\"Every Weekday\",\"description\":\"Market analysis for crypto traders and investors.\",\"thumbnail\":null,\"authors\":[{\"_key\":\"122e0ab672ab\",\"_ref\":\"nU11yqi6QiF4aQng6i2qla\",\"_type\":\"reference\"}]},\"userSubscribed\":false,\"bordered\":true}]}],[\"$\",\"div\",null,{\"children\":[\"$\",\"$L118\",null,{\"children\":[\"$\",\