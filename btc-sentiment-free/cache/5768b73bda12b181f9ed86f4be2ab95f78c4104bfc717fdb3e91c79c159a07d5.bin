className\":\"order-6 mb-4 md:order-6\",\"children\":[\"$\",\"$L69\",null,{\"slug\":\"after-10-years-ross-ulbricht-speaks-out-bitcoin-doesnt-work-without-freedom\",\"title\":\"After 10 Years, Ross Ulbricht Speaks Out: ‘Bitcoin Doesn’t Work Without Freedom’\",\"author\":{\"id\":6,\"name\":\"Jamie Redman\",\"slug\":\"jamie-redman\",\"info\":\"Jamie Redman is the News Lead at Bitcoin.com News and a financial technology journalist based in Massachusetts. He has covered bitcoin and cryptocurrency markets since 2011, focusing on bitcoin, onchain data, open-source protocols, and decentralized applications. Redman has been writing professionally since 2010 and has contributed more than 13,900 articles to Bitcoin.com News since July 2015.\\r\\n\\r\\nHis work has also appeared in Cointelegraph, Let's Talk Bitcoin, Bitcoinist, and Coingecko, and has been cited and featured in outlets including Motherboard Vice. He holds a Liberal Arts degree from Quincy College with an emphasis on writing and art.\\r\\n\\r\\nConnect with him on X and LinkedIn for more of his reporting and analysis.\\r\\n\\r\\nDisclosure: The author holds less than $500 in cryptocurrency assets.\",\"avatar\":\"https://static.news.bitcoin.com/wp-content/uploads/2025/08/jamie.png\",\"schema_id\":\"https://news.bitcoin.com/#/schema/Person/jamie-redman6\",\"profile_url\":\"https://news.bitcoin.com/author/jamie-redman/\",\"social_links\":[{\"name\":\"linkedin\",\"link\":\"https://www.linkedin.com/in/jamie-redman-4688a7a9/\"},{\"name\":\"mail-1\",\"link\":\"jamieredman@bitcoin.com\"},{\"name\":\"twitter\",\"link\":\"http://twitter.com/jamieCrypto\"},{\"name\":\"muckrack\",\"link\":\"https://muckrack.com/jamie-redman\"}],\"job_title\":\"News Lead\",\"knows_about\":[\"cryptocurrencies\",\"technology\",\"bitcoin\"],\"works_for_bitcoin_news\":true},\"isSpecialCategory\":false,\"hideAuthor\":false,\"locale\":\"en\",\"messages\":{\"writtenBy\":\"WRITTEN BY\",\"share\":\"SHARE\",\"relatedArticles\":\"Related articles\",\"aiTranslationDisclaimer\":\"This article was translated from English using AI. The original English-language version is the authoritative source; automated translations may contain inaccuracies, particularly in legal and regulatory terminology.\",\"textToSpeech\":{\"listenToArticle\":\"Listen to article\",\"listen\":\"Listen\",\"makeUsPreferred\":\"Make us preferred on Google\",\"preparing\":\"Preparing audio...\",\"settingUp\":\"Setting up the mic...\",\"processing\":\"Processing speech...\",\"audioReady\":\"Audio ready!\",\"resume\":\"Resume\",\"pause\":\"Pause\",\"stop\":\"Stop\",\"remaining\":\"remaining\",\"error\":\"Failed to generate audio. Please try again.\",\"preferUsOnGoogle\":\"Add us on Google\",\"preferUsOnGoogleInfoTitle\":\"Make Bitcoin.com your go-to news source\",\"preferUsOnGoogleInfoBody\":\"Prioritize reliable crypto news in Google by adding Bitcoin.com to your preferred sources.\",\"preferUsOnGoogleCta\":\"Show me Bitcoin.com first\"}}}]}]\n5d:[\"$\",\"time\",null,{\"dateTime\":\"2025-05-30T14:30:27.000Z\",\"className\":\"order-7 mb-4 text-sm md:hidden\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-[#818085]\",\"children\":[\"Published:\",\" \"]}],[\"$\",\"span\",null,{\"className\":\"font-medium text-shades-almost-black\",\"children\":[\"$\",\"$L65\",null,{\"isoUtc\":\"2025-05-30T14:30:27.000Z\",\"locale\":\"en\",\"fallback\":\"May 30, 2025, 10:30 AM EDT\"}]}]]}]\n5e:[\"$\",\"div\",null,{\"className\":\"order-5 md:order-7\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative -mx-4 mb-6 overflow-hidden md:mx-0\",\"children\":[[\"$\",\"$L3e\",null,{\"src\":\"https://static.news.bitcoin.com/wp-content/uploads/2025/05/hhhooppp.png\",\"alt\":\"After 10 Years, Ross Ulbricht Speaks Out: ‘Bitcoin Doesn’t Work Without Freedom’\",\"width\":1200,\"height\":675,\"className\":\"w-full h-auto object-cover block md:rounded-lg \",\"priority\":true,\"fetchPriority\":\"high\",\"sizes\":\"(max-width: 768px) 100vw, 1200px\"}],\"$undefined\"]}]}]\n5f:[\"$\",\"$L6a\",null,{\"className\":\"order-9 md:order-8\",\"shareQuoteLabel\":\"Share quote to\",\"children\":[\"$\",\"div\",null,{\"className\":\"article__body overflow-x-hidden\",\"children\":[[\"$\",\"h2\",\"0\",{\"children\":\"Silk Road Creator Ross Ulbricht Delivers First Live Speech Following Trump Pardon\"}],\" \",[\"$\",\"p\",\"2\",{\"children\":[\"Standing before a live audience on stage in Las Vegas at Bitcoin 2025, \",[\"$\",\"$L6b\",\"1\",{\"href\":\"https://news.bitcoin.com/bidding-begins-on-ross-ulbrichts-pre-arrest-and-prison-mementos-as-he-embarks-on-new-chapter/\",\"className\":\"$undefined\",\"larLinkId\":\"$undefined\",\"postId\":730105,\"sponsored\":false,\"children\":\"Ross Ulbricht\"}],\" marked a dramatic turn in his life story, addressing the crowd on the exact date—May 29—that a federal judge sentenced him to two life terms plus 40 years without parole a decade ago.\"]}],\" \",[\"$\",\"p\",\"4\",{\"children\":[\"Ulbricht, the creator of the Silk Road marketplace, was freed earlier this year after President Donald Trump \",[\"$\",\"$L6b\",\"1\",{\"href\":\"https://news.bitcoin.com/promise-fulfilled-president-trump-issues-full-pardon-to-silk-road-creator-ross-ulbricht/\",\"className\":\"$undefined\",\"larLinkId\":\"$undefined\",\"postId\":730105,\"sponsored\":false,\"children\":\"issued a full pardon\"}],\" shortly following his inauguration. The case, which sparked long-standing debate about sentencing and digital liberty, had kept Ulbricht behind bars since 2013.\"]}],\" \",[\"$\",\"p\",\"6\",{\"children\":\"“I’m free, and it’s because of you. You made this moment possible,” Ulbricht told attendees, thanking supporters who had advocated for his release over the years. His remarks, made during his Bitcoin 2025 speech, highlighted themes of “freedom, decentralization, and unity”—values he linked closely with Bitcoin’s founding principles.\"}],\" \",[\"$\",\"p\",\"8\",{\"children\":\"In his speech, Ulbricht spoke candidly about the years he spent in prison and the challenges of adapting to rapid technological change since his release. “I effectively went into a time capsule in 2013. And now I’m coming out like Rip Van Winkle,” he said. He described never having seen a drone or experienced virtual reality before his release and noted the explosion in cryptocurrency adoption since his incarceration.\"}],\" \",[\"$\",\"p\",\"10\",{\"children\":\"Referencing Bitcoin’s evolution, Ulbricht said, “When I launched Silk Road, buying a whole bitcoin would set you back less than a dollar. Pocket change. Can you imagine that?” He added:\"}],\" \",[\"$\",\"blockquote\",\"12\",{\"children\":[\"$\",\"p\",null,{\"children\":\"Now, they’re worth over $100,000 each.\"}]}],\" \",[\"$\",\"p\",\"14\",{\"children\":\"Ulbricht also emphasized the philosophical underpinnings of Bitcoin, saying, “Bitcoin doesn’t work without freedom. Bitcoin’s power comes from the fact that any one of us can mine if we choose to.” He continued:\"}],\" \",[\"$\",\"blockquote\",\"16\",{\"children\":[\"$\",\"p\",null,{\"children\":\"We are all on equal footing with Bitcoin. With Bitcoin, we are all free.\"}]}],\" \",[\"$\",\"div\",\"18\",{\"id\":\"custom_html-59\",\"className\":\"widget_text td_block_template_1 widget widget_custom_html\",\"children\":[\"$\",\"div\",null,{\"className\":\"textwidget custom-html-widget\",\"children\":[\" \",[\"$\",\"$L6c\",\"1\",{\"zoneId\":\"125723\",\"size\":\"300x250\",\"defer\":true}],\" \"]}]}],\" \",[\"$\",\"p\",\"20\",{\"children\":[\"The crowd responded with sustained applause, reflecting Ulbricht’s symbolic status in parts of the cryptocurrency community. President Trump’s pardon of Ulbricht was one of his first high-profile clemency decisions following his return to office. The move was celebrated among libertarian circles and crypto advocates. In addition to his speech, Ulbricht raised around 16 BTC worth $1.69 million with his pre-\",[\"$\",\"span\",\"1\",{\"style\":{\"fontWeight\":\"400\"},\"children\":[\"arrest gear and prison memento \",\"$L6d\",\". \"]}]]}],\" \",\"$L6e\"]}]}]\n60:[\"$\",\"$L6f\",null,{\"className\":\"order-10 md:order-9 mt-6\",\"messages\":{\"crypto\":\"Crypto\",\"fearAndGreed\":\"Fear and Greed\",\"index\":\"Index\",\"fear\":\"Fear\",\"greed\":\"Greed\",\"yesterday\":\"Yesterday\",\"lastWeek\":\"Last Week\",\"howDoYouFeel\":\"How do you feel about\",\"theMarketToday\":\"the market today?\",\"bearish\":\"Bearish\",\"bullish\":\"Bullish\",\"thanksForSharing\":\"Thanks for sharing!\",\"youreInThe\":\"You're in the\",\"feelingToday\":\"feeling {vote} today.\",\"againstTheCrowd\":\"Going against the crowd. 💪\",\"greedDominates\":\"Greed dominates sentiment. 🚀\",\"fearDominates\":\"Fear dominates sentiment. 🐻\",\"extremeFear\":\"Extreme Fear\",\"neutral\":\"Neutral\",\"extremeGreed\":\"Extreme Greed\",\"lastMonth\":\"Last Month\"}}]\n61:[\"$\",\"div\",null,{\"className\":\"order-11 md:order-10 my-l\",\"children\":[\"$\",\"$15\",null,{\"children\":\"$L70\"}]}]\n62:[\"$\",\"div\",null,{\"className\":\"order-13 my-l md:hidden\",\"children\":[\"$\",\"$15\",null,{\"children\":\"$L71\"}]}]\n63:[\"$\",\"div\",null,{\"className\":\"order-last\",\"children\":[[\"$\",\"$L72\",null,{\"locale\":\"en\",\"isReviewCategory\":false}],[\"$\",\"$L73\",null,{\"locale\":\"en\",\"messages\":{\"title\":\"Subscribe to our Newsletter\",\"description\":\"The latest crypto news, straight to your inbox.\",\"buttonLabel\":\"Subscribe\",\"subscribeButtonText\":\"Sign up for free\",\"closeLabel\":\"Close newsletter signup\",\"dismissLabel\":\"Dismiss newsletter signup\"}}]]}]\n64:[\"$\",\"$L74\",null,{\"children\":[[\"$\",\"$L75\",null,{\"locale\":\"en\",\"messages\":{\"marketOverview\":\"Market Overview\",\"getBitcoin\":\"Get Bitcoin\",\"globalMarketCap\":\"Global Market Cap\",\"totalActiveCoins\":\"Total Active Coins\",\"totalVolume\":\"Total Volume\",\"btcDominance\":\"BTC Dominance\",\"ethDominance\":\"ETH Dominance\",\"xrpMarketCap\":\"XRP Market Cap\",\"sta